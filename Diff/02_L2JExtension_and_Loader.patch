+package ext.mods.extensions.interfaces;
+
+/**
+ * Interface base para extensoes modulares carregadas dinamicamente via JARs externos (*.ext.jar).
+ */
+public interface L2JExtension
+{
+	void onLoad();
+	
+	void onDisable();
+	
+	String getName();
+}
